aws_region  = "us-east-1"
aws_profile = "dataplatform-admin"

# --- Optional: create Terraform state bucket on Cloudflare R2 in this apply ---
# export CLOUDFLARE_API_TOKEN=...   # Account API token with R2 bucket permissions (Workers R2 Storage Write / Edit)
# create_r2_state_bucket = true
# cloudflare_account_id  = "your-cloudflare-account-id"
# r2_state_bucket_name   = "dataplatform-tfstate-pfe"
# r2_bucket_location     = "ENAM"

# GitHub org/user that owns this repository
github_org = "replace-me"

# GitHub repository name
github_repo = "replace-me"

# Set to false when GitHub OIDC provider already exists in the account.
create_github_oidc_provider = true

# If create_github_oidc_provider = false, set this to existing provider ARN.
# existing_github_oidc_provider_arn = "arn:aws:iam::<account-id>:oidc-provider/token.actions.githubusercontent.com"

# For MVP this role gets admin. Replace with least-privilege policy ARNs later.
github_actions_managed_policy_arns = [
  "arn:aws:iam::aws:policy/AdministratorAccess"
]
